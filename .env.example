# Must agree with the POSTGRES_* values docker-compose.yml reads, or the API
# points at a different database than the one that was just migrated.
DATABASE_URL=postgres://notify:notify@localhost:55433/notify

# Beside Engram's 2012, so the two run side by side in development.
PORT=2013

# One line per project allowed to post, as SOURCE_<NAME>_SECRET. The secret
# alone says which project a post is from, so each must be its own, and at
# least 32 characters. None set, and the hub boots and refuses every post.
#   openssl rand -hex 32
SOURCE_ENGRAM_SECRET=
